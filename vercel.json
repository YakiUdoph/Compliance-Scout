{
  "version": 2,
  "builds": [
    { "src": "api/*.ts", "use": "@vercel/node" },
    { "src": "dist/server.js", "use": "@vercel/node" },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/audit-live", "dest": "/api/audit-live.ts" },
    { "src": "/api/(.*)", "dest": "dist/server.js" },
    { "src": "/(.*)", "dest": "web/$1" }
  ]
}
