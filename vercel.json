{
  "version": 2,
  "builds": [
    {
      "src": "dist/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/status/(.*)",
      "dest": "dist/server.js"
    },
    {
      "src": "/api/status",
      "dest": "dist/server.js"
    },
    {
      "src": "/api/audit",
      "dest": "dist/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "dist/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
